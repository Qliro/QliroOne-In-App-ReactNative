source 'https://rubygems.org'

# You may use http://rbenv.org/ or https://rvm.io/ to install and use this version
ruby ">= 2.6.10"

# Exclude problematic versions of cocoapods and activesupport that causes build failures.
gem 'cocoapods', '>= 1.13', '!= 1.15.0', '!= 1.15.1'
# The upper bound is about the ruby this has to resolve under, not about activesupport itself.
# required_ruby_version is >= 3.1 for every 7.2.x and >= 2.7 for 7.1.x; rubygems hides versions the
# running ruby cannot satisfy, and bundler then reports them as "that version can no longer be found
# in that source" — which reads like a yanked gem and is not. That is what broke build-ios on the
# macOS runner. 6.1.x asks for >= 2.5, so it resolves under the `ruby >= 2.6.10` this file declares
# support for. Raise both together, never just one.
gem 'activesupport', '>= 6.1.7.5', '!= 7.1.0', '< 7'
gem 'xcodeproj', '< 1.26.0'
gem 'concurrent-ruby', '< 1.3.4'

# Ruby 3.4.0 has removed some libraries from the standard library.
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
