# Template for example/.env — copy it, fill in the values, and keep the copy out of git:
#
#     cp .env.example .env
#
# .env is gitignored. Nothing in this template may hold a real credential.
#
# Values are inlined at build time by react-native-dotenv (see babel.config.js) and read via
# `import { ... } from '@env'` in src/qliro.ts. Metro caches the inlined values, so restart it
# with `yarn start --reset-cache` after editing this file.
#
# Ask the Payments/Checkout team for the staging values.

QLIRO_BASE_URL=https://pago.qit.nu
QLIRO_MERCHANT_API_KEY=
QLIRO_MERCHANT_SECRET=

# Merchant callback URLs. Placeholders are fine for testing.
QLIRO_MERCHANT_BASE_URL=https://example.com

# Synthetic staging test identity. Never put a real person's details here.
QLIRO_TEST_PERSONAL_NUMBER=
QLIRO_TEST_EMAIL=
QLIRO_TEST_MOBILE=
QLIRO_TEST_FIRST_NAME=
QLIRO_TEST_LAST_NAME=
QLIRO_TEST_STREET=
QLIRO_TEST_POSTAL_CODE=

# Optional: merchant order-validation endpoint that declines, for testing onPaymentDeclined.
# Must be reachable from Qliro staging (e.g. an ngrok tunnel to a local always-decline server).
QLIRO_ORDER_VALIDATION_URL=
