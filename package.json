{
  "name": "@qliro/react-native-qliro-one",
  "version": "3.0.0",
  "description": "This library is a QliroOne wrapper for React Native.",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "import": {
        "source": "./src/index.tsx",
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "source": "./src/index.tsx",
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "app.plugin.js",
    "plugin",
    "LICENSE",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!android/src/test",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "!**/example-api",
    "!**/example",
    "!lib/typescript/example-api/*"
  ],
  "scripts": {
    "example": "yarn workspace @qliro/react-native-qliro-one-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "version:sync": "node scripts/sync-version.js",
    "prepare": "node scripts/sync-version.js && bob build",
    "release": "release-it",
    "release:dev": "release-it --preRelease=dev --npm.tag=dev --no-plugins"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "author": {
    "name": "Qliro App Team",
    "email": "app@qliro.com"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qliro/QliroOne-In-App-ReactNative.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "licenseFilename": "LICENSE",
  "readmeFilename": "README.md",
  "bugs": {
    "email": "app@qliro.com"
  },
  "homepage": "https://developers.qliro.com/docs/qliro-one",
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@commitlint/config-conventional": "^21.2.0",
    "@evilmartians/lefthook": "^2.1.10",
    "@react-native-community/cli": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@release-it/conventional-changelog": "12",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.2",
    "commitlint": "^21.2.1",
    "del-cli": "^7.0.0",
    "expo": "^54.0.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.0",
    "react-test-renderer": "19.2.3",
    "release-it": "^21.0.0",
    "turbo": "^2.10.7",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.76.0"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.17.1",
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example-api/node_modules",
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/__mocks__/**",
      "!src/QliroOneCheckoutNativeComponent.ts"
    ],
    "coverageReporters": [
      "text-summary",
      "cobertura"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 85,
        "functions": 100,
        "lines": 95
      }
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}",
      "requireBranch": false
    },
    "github": {
      "release": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "QliroOneCheckoutSpec",
    "type": "components",
    "jsSrcsDir": "src",
    "outputDir": {
      "ios": "ios/generated",
      "android": "android/generated"
    },
    "android": {
      "javaPackageName": "com.qliroonereactnative"
    },
    "ios": {
      "className": "RNQliroOneCheckout"
    }
  },
  "create-react-native-library": {
    "languages": "kotlin-objc",
    "type": "fabric-view",
    "version": "0.54.5"
  }
}
